# =============================================================================
#  SOFTLY — copy to `.env` (or `.env.local`) and fill real values.
#      cp .env.example .env
#  NEVER commit `.env` / `.env.local`. NEVER paste live URLs in chat.
#  See config.txt for where to get every value and protips.
# =============================================================================

# Neon pooled URL for the Next.js app (host contains `-pooler`)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon direct URL for drizzle-kit only (no `-pooler` in the host)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

NEXT_PUBLIC_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=change-this-to-a-long-secret-password

# openssl rand -hex 32
DOWNLOAD_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ENABLE_DEMO_CHECKOUT=

RESEND_API_KEY=
EMAIL_FROM=Softly <hello@your-domain.com>

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
