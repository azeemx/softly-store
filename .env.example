# ============================================================================
#  SOFTLY — Digital Journals & E-books Store
#  Environment variables reference. Copy this file to `.env` and fill in values.
#      cp .env.example .env
#  NEVER commit your real `.env` file. It is already in .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (required)
# PostgreSQL connection string used by Drizzle ORM.
# NEVER paste a real connection string into chat, git, issues or screenshots.
# Always keep this file in .env (gitignored); this .env.example stays clean.
#
# NEON: copy the connection string from your Neon dashboard
#   Console -> your project -> Connect -> (1) Pooled / (2) Direct
#   - App on serverless host (Vercel/Cloudflare) => use the POOLED ("-pooler") URL
#   - drizzle-kit / long-running server        => use the DIRECT URL
#   Append  ?sslmode=verify-full  for real TLS verification (no pg warning).
# Then run:  ./scripts/db-setup.sh
# ----------------------------------------------------------------------------
# Neon (serverless/pooled):
# DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<ENDPOINT>-pooler.<REGION>.aws.neon.tech/neondb?sslmode=verify-full
# Neon (direct, for migrations/drizzle-kit):
# DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<ENDPOINT>.<REGION>.aws.neon.tech/neondb?sslmode=verify-full
# Local sandbox:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ----------------------------------------------------------------------------
# SITE URL (recommended in production)
# The canonical, public HTTPS origin of your site. Used for email links,
# Stripe redirects, sitemap.xml, robots.txt and SEO/OpenGraph.
# NEXT_PUBLIC_SITE_URL is exposed to the browser; SITE_URL is server-only.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

# ----------------------------------------------------------------------------
# ADMIN ACCOUNT (recommended in production)
# Set BOTH to create/rotate your private admin login. When either is set,
# the built-in preview admin (hello@softly.studio) is disabled automatically.
# Use a long, unique password.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=change-this-to-a-long-secret-password

# ----------------------------------------------------------------------------
# DOWNLOAD SECRET (recommended in production)
# A long random string used to sign expiring guest download/reading links.
# Keep it STABLE — changing it invalidates all existing guest links.
# Generate one:  openssl rand -hex 32
# If omitted, the app derives one from STRIPE_SECRET_KEY or DATABASE_URL.
# ----------------------------------------------------------------------------
DOWNLOAD_SECRET=

# ----------------------------------------------------------------------------
# STRIPE PAYMENTS (required for real payments)
# Without these, the store runs in labeled "Preview checkout" mode (no charges).
# - STRIPE_SECRET_KEY: server secret (sk_live_... / sk_test_...)
# - STRIPE_WEBHOOK_SECRET: from your webhook endpoint (whsec_...)
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: enables the on-page card form (pk_...)
#
# Webhook endpoint to add in Stripe:  https://your-domain.com/api/webhooks/stripe
# Listen for these events:
#   payment_intent.succeeded, payment_intent.payment_failed,
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, charge.refunded
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Set to "false" to disable preview checkout before payments are configured.
ENABLE_DEMO_CHECKOUT=

# ----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL — Resend (recommended in production)
# Sends welcome, verification, password reset, order confirmation, download
# link, refund, and contact-form emails. Verify your sender domain in Resend.
# - RESEND_API_KEY: your Resend API key (re_...)
# - EMAIL_FROM: verified From address, e.g. "Softly <hello@your-domain.com>"
# ----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Softly <onboarding@resend.dev>

# ----------------------------------------------------------------------------
# PRIVATE FILE STORAGE — Cloudflare R2 / S3-compatible (recommended in prod)
# Stores uploaded PDFs and images privately. Without these, uploads use local
# disk (fine for a single persistent server, NOT for serverless hosting).
# Create an R2 bucket + API token, then fill all four values.
#   R2_ENDPOINT example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ----------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ----------------------------------------------------------------------------
# NODE ENV (set automatically by most hosts; usually leave unset locally)
# ----------------------------------------------------------------------------
# NODE_ENV=production
